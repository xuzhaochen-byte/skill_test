# ============================================================================
# ad-creative-benchmark — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` (which must stay OUT of version control / sharing)
# and fill in YOUR OWN credentials. Never commit real keys.
# Load it before running the skill, e.g.:
#   set -a; source ad-creative-benchmark/.env; set +a
# Then verify with:
#   python ad-creative-benchmark/scripts/preflight_check.py --workflow all --provider aidp --need-ark --need-image-gen
#
# Each variable below maps to one part of the pipeline. You only need the
# variables for the workflow(s) you actually run (see references/environment_setup.md).
# Several variables accept MULTIPLE keys separated by commas; retries rotate across them.
# ============================================================================

# --- Aeolus / bytedcli (benchmark + CTR Top discovery) ----------------------
# No API key here: authenticate via your normal `bytedcli` login/access flow.
# Scripts default this to i18n; set it explicitly if your shell is ambiguous.
BYTEDCLI_CLOUD_SITE=i18n

# --- AIDP (benchmark/reference-pattern MLLM analysis ONLY) -------------------
# Used for: whole-video analysis, URL->industry fallback, AIDP landing-page similarity.
# Do NOT reuse these for URL-to-creative generation. Comma/semicolon/newline separated.
AIDP_AK_LIST=your_aidp_key_1,your_aidp_key_2,your_aidp_key_3

# --- ModelHub (URL review / planning / captions ONLY) -----------------------
# Used for: --visual-review / --generation-planner / --caption-generator = modelhub.
# Intentionally separate from AIDP_AK* — different internal model access.
MODELHUB_AK=your_modelhub_key
# Optional explicit endpoint overrides (otherwise built from the key above):
# MODELHUB_ENDPOINT=
# GENERATION_PLANNER_ENDPOINT=

# --- Coze (URL web-search enrichment, default provider) ---------------------
# Required when web search is enabled (the default). Pass --no-web-search to skip.
COZE_API_TOKEN=your_coze_pat_token

# --- Ark (image-to-video generation) ----------------------------------------
# Comma-separated keys; ARK_MODEL_NAME pairs each key with its endpoint/model id.
ARK_API_KEYS=your_ark_key_1,your_ark_key_2,your_ark_key_3
ARK_MODEL_NAME=your_ark_model_id_1,your_ark_model_id_2,your_ark_model_id_3

# --- Image creative generation ----------------------------------------------
IMAGE_GEN_AK=your_image_gen_key
# Optional overrides:
# IMAGE_GEN_ENDPOINT=
# IMAGE_GEN_BASE_URL=
# IMAGE_GEN_REFERENCE_MODE=

# --- Public upload (only if you proceed to TikTok campaign upload/create) ----
# Default uploader = humanaigc; requires both AK and SK.
PUBLIC_TOS_AK=your_public_tos_ak
PUBLIC_TOS_SK=your_public_tos_sk
